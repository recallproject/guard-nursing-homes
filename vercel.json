{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/stripe-webhook",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/verify-subscription",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/check-subscription",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-cache, no-store" }
      ]
    },
    {
      "source": "/api/send-evidence",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/verify-token",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' js.stripe.com plausible.io us.i.posthog.com us-assets.i.posthog.com 'unsafe-inline'; style-src 'self' fonts.googleapis.com 'unsafe-inline'; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' api.stripe.com plausible.io us.i.posthog.com formspree.io; frame-src 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "oversightreports.com" }],
      "destination": "https://www.oversightreports.com/:path",
      "statusCode": 301
    },
    {
      "source": "/favorites",
      "destination": "/watchlist",
      "statusCode": 301
    },
    {
      "source": "/ask-clinician",
      "destination": "/ask-a-clinician",
      "statusCode": 301
    },
    {
      "source": "/map",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/california",
      "destination": "/states/california",
      "statusCode": 301
    },
    {
      "source": "/evidence/:ccn",
      "destination": "/facility/:ccn",
      "statusCode": 301
    },
    {
      "source": "/contact",
      "destination": "/ask-a-clinician",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/state/:code", "destination": "/index.html" },
    { "source": "/states/:stateCode/:typeSlug", "destination": "/index.html" }
  ]
}
